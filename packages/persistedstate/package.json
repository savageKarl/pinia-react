{
  "name": "@pinia-react/persistedstate",
  "version": "1.0.1",
  "description": "Synchronous persisted state plugin for pinia-react",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/savageKarl/pinia-react#readme",
  "bugs": {
    "url": "https://github.com/savageKarl/pinia-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savageKarl/pinia-react.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "pinia-react",
    "persistence",
    "localStorage",
    "state-management"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test-dts": "tsc -p ./test-dts/tsconfig.json && node ./scripts/check-editor.mjs && node ./scripts/check-docs.mjs",
    "test-package": "node ./scripts/check-package.mjs",
    "test-editor": "node ./scripts/check-editor.mjs",
    "test-docs": "node ./scripts/check-docs.mjs",
    "test-docs-built": "node ./scripts/check-docs.mjs --rendered",
    "test-next-ssr": "node ./scripts/check-next-ssr.mjs"
  },
  "peerDependencies": {
    "pinia-react": "^3.0.0"
  },
  "devDependencies": {
    "pinia-react": "workspace:*",
    "@pinia-react/devtools": "workspace:*"
  }
}
