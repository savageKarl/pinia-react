{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "pinia-react": ["../../pinia/src"],
      "pinia-react/next": ["../../pinia/src/next.ts"],
      "@pinia-react/devtools": ["../../devtools/src"],
      "@pinia-react/persistedstate": ["../../persistedstate/src"],
      "@pinia-react/persistedstate/next": ["../../persistedstate/src/next.ts"]
    }
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx", "../shared/**/*.d.ts"],
  "exclude": ["node_modules"]
}
